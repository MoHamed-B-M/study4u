<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal RemoteViews shown if the comic dashboard fails to render,
     so the launcher never displays its "problem loading widget" state. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fallback_text"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:text="@string/widget_fallback_text"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1" />
